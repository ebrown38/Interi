# SPDX-License-Identifier: MIT
# Compiler versions CI builds with (major.minor). tools/ci/check_toolchain.py fails a job whose compilers differ, so a
# toolchain upgrade is an explicit change to this file. The MSVC toolset (14.xx, cl 19.xx) is also what
# ilammy/msvc-dev-cmd selects; it is part of the module toolchain fingerprint (_MSC_VER).
CLANG=22.1
CLANG_FORMAT=22.1
MSVC_TOOLSET=14.51
