{
  "version": 1,
  "nodes": [
    { "id": "left", "event": "trigger.InputAction", "params": { "key": { "const": "moveLeft" } } },
    { "id": "right", "event": "trigger.InputAction", "params": { "key": { "const": "moveRight" } } },
    { "id": "up", "event": "trigger.InputAction", "params": { "key": { "const": "moveUp" } } },
    { "id": "down", "event": "trigger.InputAction", "params": { "key": { "const": "moveDown" } } },
    { "id": "stepLeft", "event": "world.Move", "params": { "delta": { "const": [-1, 0, 0] } } },
