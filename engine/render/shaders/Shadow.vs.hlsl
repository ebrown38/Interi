// Shadow map depth pass: transforms vertices into one cascade's shadow clip space. Draws are generated by the
// culling pass, whose firstInstance is the object index.
#include "ForwardCommon.hlsli"

struct Push
{
    uint vertices;
    uint scene;
    uint cascade;
    uint pad;
};
[[vk::push_constant]] Push g_Push;

float4 main(uint vertexId : SV_VertexID, [[vk::builtin("BaseInstance")]] uint objectIndex : BASE_INSTANCE)
    : SV_Position
{
    const float3 position = g_Buffers[g_Push.vertices].Load<float3>(vertexId * 24);
    const float4 world =
        mul(LoadMat4(g_Push.scene, ObjectOffset(objectIndex) + kObjectModel), float4(position, 1.0));
    return mul(LoadMat4(g_Push.scene, kFrameCascades + g_Push.cascade * 64), world);
}
