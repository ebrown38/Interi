# SPDX-License-Identifier: MIT
# cmake -DINPUT=<file.spv> -DOUTPUT=<header.h> -DSYMBOL=<name> -P EmbedSpirv.cmake
# Writes a header with the SPIR-V module as `inline constexpr std::uint32_t <SYMBOL>[]` (little-endian words).

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR remainder "${length} % 8")
if(length EQUAL 0 OR NOT remainder EQUAL 0)
    message(FATAL_ERROR "${INPUT} is not a SPIR-V module (size is not a multiple of 4 bytes)")
endif()

# Each 8 hex digits are one word stored little-endian: bytes b0 b1 b2 b3 -> 0xb3b2b1b0.
string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," words "${hex}")
string(REGEX REPLACE "((0x[0-9a-f]+u,){8})" "\\1\n    " words "${words}")

file(WRITE "${OUTPUT}"
"// SPDX-License-Identifier: MIT
// Generated by cmake/EmbedSpirv.cmake from ${INPUT}. Do not edit.
#pragma once

#include <cstdint>

inline constexpr std::uint32_t ${SYMBOL}[] = {
    ${words}
};
")
