{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "interi",
  "version": "0.1.0",
  "license": "MIT",
  "builtin-baseline": "e456309491fd875487bf02b8a0dca76c1b1b00cc",
  "dependencies": [
    "benchmark",
    "cgltf",
    {
      "name": "directx-dxc",
      "host": true
    },
    "gtest",
    {
      "name": "imgui",
      "features": [
        "docking-experimental"
      ]
    },
    "manifold",
    "meshoptimizer",
    "miniaudio",
    "nlohmann-json",
    "recastnavigation",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "wayland",
          "platform": "linux"
        },
        {
          "name": "x11",
          "platform": "linux"
        },
        "vulkan"
      ]
    },
    "spirv-reflect",
    {
      "name": "tracy",
      "default-features": false,
      "features": [
        "on-demand"
      ]
    },
    "volk",
    "vulkan-headers",
    "vulkan-memory-allocator",
    "xxhash"
  ]
}
